# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.

# Db2 on Cloud: the service-credentials JSON downloaded from the Db2 instance
# (needs connection.db2.hosts[0], .database, .authentication, .certificate.certificate_base64)
DB2_CONFIG_FILE=path/to/db2-credentials.json

# watsonx Orchestrate: service-credentials JSON with "apikey" and "url"
ORCHESTRATE_CREDENTIALS_FILE=path/to/orchestrate-credentials.json
# ORCHESTRATE_AGENT_NAME=banking_rm_assistant

# Kafka on Confluent Platform (SASL_SSL / PLAIN)
KAFKA_BOOTSTRAP=<vm-ip>:9094,<vm-ip>:9095,<vm-ip>:9096
KAFKA_USERNAME=kafka-admin
KAFKA_PASSWORD=<kafka-admin-password>
# CA certificate that signs the broker certs (scp it from the VM, see confluent.md section 6)
KAFKA_CA_FILE=backend/certs/kafka-ca.crt
